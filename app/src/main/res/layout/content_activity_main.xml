<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <android.support.v7.widget.RecyclerView
        android:id="@+id/recycle_view"
        android:layout_marginTop="3dp"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_above="@+id/like_reject_bt_layerRl" />
    <TextView
        android:id="@+id/nolist"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="NoList"
        android:visibility="gone"
        android:gravity="center"
        android:textAppearance="?android:textAppearanceMedium"
        android:textColor="@color/colorAccent"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentLeft="true"
        android:background="@mipmap/bg1"
        android:layout_alignParentStart="true"
        android:id="@+id/like_reject_bt_layerRl">
        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_height="match_parent">
        <ImageView
            android:id="@+id/reject_bt_rl1"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="0.5"
            android:src="@mipmap/reject_btn"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true" />
            <ImageView
                android:id="@+id/like_bt_rl1"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@mipmap/like_btn"
                android:layout_weight="0.5"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true" />
        </LinearLayout>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentLeft="true"
        android:background="@mipmap/black_layer"
        android:visibility="gone"
        android:id="@+id/reject_button_layerRl"
        android:layout_alignParentStart="true">
        <ImageView
            android:id="@+id/reject_btn_layerIv"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="0.5"
            android:src="@mipmap/reject_btn"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true" />
        </RelativeLayout>

</RelativeLayout>