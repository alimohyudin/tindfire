<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorAccent"
    android:orientation="vertical"
    android:theme="@style/ThemeOverlay.AppCompat.Dark">



    <RelativeLayout
        android:id="@+id/location_container_ll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_alignParentTop="true"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true">

        <LinearLayout
            android:id="@+id/matchll"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:padding="1dp"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:layout_weight="0.8"
                android:padding="5dp"
                android:textAppearance="?android:textAppearanceMedium"
                android:text="@string/match"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="0.2"
                android:layout_gravity="center"
                android:src="@mipmap/next_arrow"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/already_liked_me"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:padding="1dp"
            android:layout_below="@+id/matchll"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:layout_weight="0.8"
                android:padding="5dp"
                android:textAppearance="?android:textAppearanceMedium"
                android:text="@string/alreaady_liked_me"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="0.2"
                android:layout_gravity="center"
                android:src="@mipmap/next_arrow"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/already_super_liked_me"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:padding="1dp"
            android:layout_below="@+id/already_liked_me"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:layout_weight="0.8"
                android:padding="5dp"
                android:textAppearance="?android:textAppearanceMedium"
                android:text="@string/superlike"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="0.2"
                android:layout_gravity="center"
                android:src="@mipmap/next_arrow"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/facebook_frndLL"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:padding="1dp"
            android:layout_below="@+id/already_super_liked_me"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:layout_weight="0.8"
                android:padding="5dp"
                android:textAppearance="?android:textAppearanceMedium"
                android:text="@string/facebook_friends"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="0.2"
                android:layout_gravity="center"
                android:src="@mipmap/next_arrow"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/messagee_ll"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_marginLeft="5dp"
            android:visibility="gone"
            android:layout_marginRight="5dp"
            android:padding="1dp"
            android:layout_below="@+id/facebook_frndLL"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:layout_weight="0.8"
                android:padding="5dp"
                android:textAppearance="?android:textAppearanceMedium"
                android:text="@string/message"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="0.2"
                android:layout_gravity="center"
                android:src="@mipmap/next_arrow"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/settingLL"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:padding="1dp"
            android:layout_below="@+id/messagee_ll"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:layout_weight="0.8"
                android:padding="5dp"
                android:textAppearance="?android:textAppearanceMedium"
                android:text="@string/setting"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="0.2"
                android:layout_gravity="center"
                android:src="@mipmap/next_arrow"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/logoutLL"
            android:layout_width="match_parent"
            android:layout_below="@+id/settingLL"
            android:orientation="horizontal"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:padding="1dp"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:layout_weight="0.8"
                android:padding="5dp"
                android:textAppearance="?android:textAppearanceMedium"
                android:text="@string/logout"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="0.2"
                android:layout_gravity="center"
                android:src="@mipmap/next_arrow"/>
        </LinearLayout>

    </RelativeLayout>
    <ImageView
        android:id="@+id/logoutIv"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:src="@mipmap/logout"
        android:layout_gravity="center_horizontal"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="38dp" />
    <ImageView
        android:id="@+id/facebookLink"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:src="@mipmap/fb"
        android:layout_marginLeft="20dp"
        android:layout_gravity="center_horizontal"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="38dp" />
    <ImageView
        android:id="@+id/twitterLink"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:src="@mipmap/twitter"
        android:layout_marginRight="20dp"
        android:layout_gravity="center_horizontal"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="38dp" />

</RelativeLayout>
