<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:layout_weight="0.4">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@mipmap/pic1"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:orientation="vertical"
        android:layout_weight="0.5">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lina,22"
            android:textColor="@color/black"
            android:singleLine="true"
            android:padding="3dp"
            android:textAppearance="?android:textAppearanceMedium"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="horizontal"

            android:layout_height="wrap_content">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 mile away"
            android:singleLine="true"
            android:textColor="@color/text_view_color"
            android:padding="3dp"
            android:textAppearance="?android:textAppearanceSmall"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Active 1 day ago"
            android:textColor="@color/text_view_color"
            android:padding="3dp"
            android:singleLine="true"
            android:textAppearance="?android:textAppearanceSmall"/>
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="I want somebody to at look at me the way i look  at wine and to feel me."
            android:textColor="@color/text_view_color"
            android:padding="3dp"
            android:textAppearance="?android:textAppearanceMedium"/>
    </LinearLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="80dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentLeft="true"
            android:background="@color/colorAccent"
            android:layout_alignParentStart="true">
        </RelativeLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:gravity="center"
            android:id="@+id/reject_rl"
            android:layout_weight="0.5"
            android:layout_height="match_parent">
        <ImageView
            android:layout_width="60dp"
            android:layout_height="80dp"
            android:src="@mipmap/profile_reject_btn" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/like_rl"
            android:layout_width="match_parent"
            android:gravity="center"
            android:layout_height="match_parent"
            android:layout_weight="0.5">
            <ImageView
                android:layout_width="60dp"
                android:layout_height="80dp"
                android:src="@mipmap/profile_like_btn" />
        </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
    



</LinearLayout>